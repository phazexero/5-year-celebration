{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "anniversary": {
        ".read": "auth != null",
        ".write": "auth != null",

        "players": {
          "$role": {
            ".validate": "($role === 'me' || $role === 'her') && newData.hasChildren(['uid', 'online'])",
            "uid": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "online": { ".validate": "newData.isBoolean()" },
            "lastSeen": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "match": {
          ".validate": "newData.hasChildren(['gameId', 'status', 'mode', 'deck', 'scores', 'turn', 'moves', 'seq', 'startedAt'])",
          "gameId": { ".validate": "newData.isString() && newData.val().length <= 32" },
          "status": { ".validate": "newData.val() === 'playing' || newData.val() === 'done'" },
          "mode": { ".validate": "newData.val() === 'competitive' || newData.val() === 'coop'" },
          "turn": { ".validate": "newData.val() === 'me' || newData.val() === 'her'" },
          "deck": {
            "$k": { ".validate": "newData.hasChild('y') && (newData.hasChild('i') || newData.hasChild('u'))" }
          },
          "flipped": {
            "$k": { ".validate": "newData.isNumber()" }
          },
          "mismatch": { ".validate": "newData.isBoolean()" },
          "matched": {
            "$k": { ".validate": "newData.val() === 'me' || newData.val() === 'her'" }
          },
          "scores": {
            ".validate": "newData.hasChildren(['me', 'her'])",
            "me": { ".validate": "newData.isNumber()" },
            "her": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          },
          "moves": { ".validate": "newData.isNumber()" },
          "seq": { ".validate": "newData.isNumber()" },
          "startedAt": { ".validate": "newData.isNumber()" },
          "finishedAt": { ".validate": "newData.isNumber()" },
          "lastMatch": { ".validate": "newData.hasChildren(['card', 'by', 'seq'])" },
          "$other": { ".validate": false }
        },
        "matchBest": {
          ".validate": "newData.hasChildren(['timeMs', 'moves', 'at', 'gameId'])",
          "timeMs": { ".validate": "newData.isNumber()" },
          "moves": { ".validate": "newData.isNumber()" },
          "at": { ".validate": "newData.isNumber()" },
          "gameId": { ".validate": "newData.isString()" },
          "$other": { ".validate": false }
        },
        "quiz": {
          ".validate": "newData.hasChildren(['gameId', 'status', 'order', 'round', 'phase', 'scores', 'seq'])",
          "gameId": { ".validate": "newData.isString() && newData.val().length <= 32" },
          "status": { ".validate": "newData.val() === 'playing' || newData.val() === 'done'" },
          "phase": { ".validate": "newData.val() === 'answering' || newData.val() === 'revealed'" },
          "round": { ".validate": "newData.isNumber()" },
          "order": {
            "$k": { ".validate": "newData.isNumber()" }
          },
          "answers": {
            "$role": {
              ".validate": "($role === 'me' || $role === 'her') && newData.hasChildren(['v'])",
              "v": { ".validate": "newData.isString() && newData.val().length <= 300" },
              "$other": { ".validate": false }
            }
          },
          "agree": {
            "$role": { ".validate": "($role === 'me' || $role === 'her') && newData.isBoolean()" }
          },
          "correct": { ".validate": "newData.isBoolean()" },
          "scores": {
            ".validate": "newData.hasChildren(['me', 'her'])",
            "me": { ".validate": "newData.isNumber()" },
            "her": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          },
          "history": {
            "$k": { ".validate": "newData.hasChildren(['q', 'correct'])" }
          },
          "seq": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },

        "gallery": {
          "meta": {
            "$year": {
              ".validate": "$year === 'y1' || $year === 'y2' || $year === 'y3' || $year === 'y4' || $year === 'y5'",
              "$id": {
                ".validate": "newData.hasChildren(['caption', 'date', 'place', 'at'])",
                "caption": { ".validate": "newData.isString() && newData.val().length <= 300" },
                "date": { ".validate": "newData.isString() && newData.val().length <= 20" },
                "place": { ".validate": "newData.isString() && newData.val().length <= 120" },
                "at": { ".validate": "newData.isNumber()" },
                "w": { ".validate": "newData.isNumber()" },
                "h": { ".validate": "newData.isNumber()" },
                "$other": { ".validate": false }
              }
            }
          },
          "data": {
            "$id": {
              ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length <= 1200000"
            }
          },
          "$other": { ".validate": false }
        },

        "$other": { ".validate": false }
      }
    }
  }
}
