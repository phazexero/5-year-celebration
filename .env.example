# Copy this file to .env.local and fill in the values.
# Every variable here must also be added in Vercel > Project > Settings > Environment Variables.

# SHA-256 of the site password. Generate with:  node scripts/hash-password.mjs "your password"
VITE_SITE_PASSWORD_HASH=

# Firebase web app config (Firebase console > Project settings > Your apps > Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Local testing only: set to 1 to use the Firebase emulators instead of the real project
VITE_USE_FIREBASE_EMULATOR=
